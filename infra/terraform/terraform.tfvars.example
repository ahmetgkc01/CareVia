aws_region         = "eu-central-1"
monthly_budget_usd = 20
budget_email       = "your-email@example.com"

# Add only trusted public IP addresses. Never use 0.0.0.0/0.
allowed_postgres_cidrs = [
  "203.0.113.10/32",
]

# Development can remain public only because the security group accepts explicit /32 addresses.
# Prefer false when the application and database share private network connectivity.
database_publicly_accessible = true
database_deletion_protection = true
database_skip_final_snapshot = false
backup_retention_days        = 7

db_instance_class       = "db.t4g.micro"
db_allocated_storage_gb = 20
backup_retention_days   = 1
