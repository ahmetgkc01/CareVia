DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CAREVIA_RELEASE=development
CAREVIA_REPOSITORY_URL=https://github.com/ahmetgokce89/CareVia
POSTGRES_DB=carevia
POSTGRES_USER=carevia
POSTGRES_PASSWORD=carevia
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Set to require when connecting to AWS RDS. Leave empty for local PostgreSQL.
POSTGRES_SSLMODE=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_THROTTLE_RATE=5/min
ASSISTANT_THROTTLE_RATE=20/hour

# Optional OpenAI Responses API. Leave URL or model empty for deterministic demo mode.
GENAI_API_URL=https://api.openai.com/v1/responses
GENAI_API_KEY=
GENAI_MODEL=gpt-6-luna
GENAI_TIMEOUT_SECONDS=20
# Optional observability values. Set these to the provider's current USD rates.
GENAI_INPUT_COST_PER_MILLION=0
GENAI_OUTPUT_COST_PER_MILLION=0
ASSISTANT_HISTORY_MESSAGES=6
ASSISTANT_HISTORY_MAX_CHARS=6000

# Vector embeddings. Keep the API key outside version control.
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=20
KNOWLEDGE_SEARCH_LIMIT=3
KNOWLEDGE_MAX_COSINE_DISTANCE=0.45

